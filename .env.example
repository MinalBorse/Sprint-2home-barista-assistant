# Copy this file to ".env" and put your own values in it.
# Never commit your real .env file (it's in .gitignore).

# Your OpenRouter API key (https://openrouter.ai -> Keys)
OPENROUTER_API_KEY=sk-or-your-key-here

# The chat model and the embedding model (via OpenRouter)
MODEL_NAME=openai/gpt-4o-mini
EMBEDDING_MODEL_NAME=openai/text-embedding-3-small

# How the app identifies itself when it loads web pages
USER_AGENT=HomeBaristaAssistant/1.0 (student learning project)
